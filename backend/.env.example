# RecoverAI environment
# Leave the Razorpay keys as-is to run FULLY OFFLINE (demo mode: payment links
# are simulated and outcomes are deterministic). To switch to real Razorpay
# Test Mode, paste your test keys below — no code changes needed.

DATABASE_URL=sqlite:///./recoverai.db

RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE
# Optional: set this to verify real webhook signatures.
RAZORPAY_WEBHOOK_SECRET=
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
