# Public origin of the deployed backend, including the /api suffix.
# Vite inlines this at BUILD time, so it must be set in Vercel's env vars
# before the build runs -- changing it later requires a redeploy.
#
# Leave it unset for local dev: the Vite proxy handles /api itself.
VITE_API_BASE=https://recoverai-api.onrender.com/api
